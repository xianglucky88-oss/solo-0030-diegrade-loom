    {"id":"wafer","name":"登记晶圆形状","entry":"POST /wafers","steps":["校验物理行段和保留点","冻结选定规则"],"module_ids":["http","storage","rules","geometry"],"success":"规则后来升级不影响该片","failure":"重叠行段拒绝","verification":"python3 -B -m tools.smoke --through wafer"},
    {"id":"preview","name":"试算归一批次","entry":"POST /wafers/{id}/preview","steps":["解析探针表与坐标系","复算拟写入的格点判档"],"module_ids":["http","intake","geometry","probe","timeline","storage"],"success":"列出拟变更但代次不变","failure":"保留点不可投测","verification":"python3 -B -m tools.smoke --through preview"},
    {"id":"ingest","name":"导入探针批次","entry":"POST /wafers/{id}/batches","steps":["检查代次和规范批次内容","原子提交全部有效行"],"module_ids":["http","intake","probe","timeline","storage"],"success":"逆序重传仍幂等","failure":"任一父引用错误阻止整批","verification":"python3 -B -m tools.smoke --through ingest"},
    {"id":"grid","name":"复核格点状态","entry":"GET /wafers/{id}","steps":["读取并归并现场记录","组成图、计数及可签状态"],"module_ids":["http","workbench","intake","timeline"],"success":"独立显示未测和待复测","failure":"错误晶圆不可查看","verification":"python3 -B -m tools.smoke --through grid"},
    {"id":"trace","name":"追查逐颗证据","entry":"GET /wafers/{id}/cells/{x}/{y}","steps":["定位物理点与邻域","沿现场事件输出设备坐标和判档依据"],"module_ids":["http","workbench","timeline","geometry"],"success":"能够追溯四分之一圈变换前的记录","failure":"掩模外格点拒绝","verification":"python3 -B -m tools.smoke --through trace"},
    {"id":"seal","name":"签出完整分选版","entry":"POST /wafers/{id}/releases","steps":["校验代次与整片就绪","封存证据与分选行"],"module_ids":["http","archive","storage","sorter","timeline"],"success":"同代重复签出摘要不变","failure":"有未完成格点不可签出","verification":"python3 -B -m tools.smoke --through seal"},
    {"id":"replay","name":"回放封存输入","entry":"GET .../releases/{rev}/replay","steps":["校验封存摘要","以原规则重算分选行"],"module_ids":["http","archive","timeline","sorter"],"success":"返回复算一致与行数","failure":"不存在的分选版不可回放","verification":"python3 -B -m tools.smoke --through replay"},
    {"id":"export","name":"下载分选表","entry":"GET .../releases/{rev}/sorter","steps":["验证分选版","序列化稳定 CSV"],"module_ids":["http","archive","sorter"],"success":"顺序固定且不含保留点","failure":"工作态不能直接导出","verification":"python3 -B -m tools.smoke --through export"},
    {"id":"hold","name":"重新开放逐颗复测","entry":"POST /wafers/{id}/holds","steps":["核实当前格点已有终档","追加复核并阻止新版签出"],"module_ids":["http","intake","storage","timeline"],"success":"旧版不变，现场待复测","failure":"保留点不能复核","verification":"python3 -B -m tools.smoke --through hold"},
    {"id":"round","name":"开立两站复测轮次","entry":"POST /wafers/{id}/rounds","steps":["核实格点当前待复测","登记两个工位并锁定父量测","阻塞普通复测与签出"],"module_ids":["http","intake","storage","timeline"],"success":"有独立编号的轮次开始收件","failure":"非待复测点或已有未结轮次拒绝","verification":"python3 -B -m tools.smoke --through rounds"},
    {"id":"submit","name":"登记工位来件","entry":"POST /wafers/{id}/rounds/{rid}/submissions","steps":["按工位设备位姿归一单颗来件","核对轮次、工位、物理点与父量测","每站只收首份证据"],"module_ids":["http","intake","probe","timeline","storage"],"success":"两站可按任意顺序送齐，开路也留证","failure":"重复内容不覆盖、旧轮编号与错点错父拒绝","verification":"python3 -B -m tools.smoke --through rounds"},

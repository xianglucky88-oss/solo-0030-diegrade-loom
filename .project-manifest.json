    {"id":"probe","paths":["diegrade/probe_csv.py","diegrade/batches.py"],"responsibility":"校验并映射设备表"},
    {"id":"timeline","paths":["diegrade/grading.py","diegrade/timeline.py"],"responsibility":"决定档位和逐颗有效证据"},
